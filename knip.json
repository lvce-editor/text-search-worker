{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "entry": ["src/build.js", "src/computeNodeModulesCacheKey.js", "src/measureMemory.js"],
      "project": ["src/**/*.{js,ts}"],
      "ignoreDependencies": ["esbuild", "playwright"]
    },
    "packages/text-search-worker": {
      "entry": ["src/textSearchWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/postinstall.js"],
      "project": ["src/**/*.js"]
    }
  }
}
